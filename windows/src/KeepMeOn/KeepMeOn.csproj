<Project Sdk="Microsoft.NET.Sdk">

  <!-- App per l'area di notifica. .NET Framework 4.8 è già installato in Windows 10 e 11:
       un solo eseguibile, niente da installare. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KeepMeOn</RootNamespace>
    <AssemblyName>KeepMeOn</AssemblyName>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.1</Version>
    <Product>KeepMeOn</Product>
    <Company>Christian Musumeci</Company>
    <Copyright>© 2026 Christian Musumeci</Copyright>
    <Description>Stay available on Microsoft Teams even when you step away for a moment.</Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- La logica pura entra come sorgente: niente DLL accanto all'eseguibile. -->
    <Compile Include="..\KeepMeOn.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="Resources\*.ico" LogicalName="%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="KeepMeOn.Probe" />
  </ItemGroup>

</Project>
